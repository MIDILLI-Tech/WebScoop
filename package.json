{
  "name": "webscoop",
  "version": "0.50.0",
  "description": "Open-source cross-platform website mirroring tool for offline browsing",
  "productName": "WebScoop",
  "main": "./out/main/index.js",
  "author": "WebScoop Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "cli": "tsx scripts/cli.ts",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:unsigned": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "puppeteer-core": "^25.14.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.4.47",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/tough-cookie": "^4.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "cheerio": "^1.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "node-cron": "^4.6.0",
    "p-queue": "^10.0.0",
    "pinia": "^4.1.0",
    "postcss": "^8.5.30",
    "postcss-value-parser": "^4.2.0",
    "robots-parser": "^3.0.1",
    "sass": "^1.105.2",
    "tough-cookie": "^6.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "undici": "^8.12.2",
    "uuid": "^14.0.3",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "vuetify": "^4.2.6"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "better-sqlite3@13.0.3": true,
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
